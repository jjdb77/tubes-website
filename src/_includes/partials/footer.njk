<section class="explore-footer">
  <div class="container explore-footer-grid">
    {#- Handmatig gecategoriseerd (niet settings.footer_nav): dekt dezelfde
        pagina's (Platform, Solutions, Plans, Compliance, Company, Academy,
        Contact) zodat Google Platform en Plans hier blijft vinden, plus de
        Insights-artikelen en de book-a-call-links erbij. -#}
    <div class="explore-footer-col">
      <h3>Platform</h3>
      <ul class="footer-links">
        <li><a href="/platform/"{% if page.url == "/platform/" %} aria-current="page"{% endif %}>Overview</a></li>
        <li><a href="/solutions/"{% if page.url == "/solutions/" %} aria-current="page"{% endif %}>Solutions</a></li>
        <li><a href="/plans/"{% if page.url == "/plans/" %} aria-current="page"{% endif %}>Plans & Pricing</a></li>
        <li><a href="/compliance/"{% if page.url == "/compliance/" %} aria-current="page"{% endif %}>Security & Compliance</a></li>
      </ul>
    </div>
    <div class="explore-footer-col">
      <h3>Company</h3>
      <ul class="footer-links">
        <li><a href="/company/"{% if page.url == "/company/" %} aria-current="page"{% endif %}>About</a></li>
        <li><a href="/academy/"{% if page.url == "/academy/" %} aria-current="page"{% endif %}>Academy</a></li>
        <li><a href="/contact/"{% if page.url == "/contact/" %} aria-current="page"{% endif %}>Contact</a></li>
      </ul>
    </div>
    <div class="explore-footer-col">
      <h3>Resources</h3>
      <ul class="footer-links">
        {% for item in collections.insights.slice(0, 4) %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.data.title }}</a></li>
        {% endfor %}
        <li><a href="/insights/"{% if page.url == "/insights/" %} aria-current="page"{% endif %}>All Insights</a></li>
      </ul>
    </div>
    <div class="explore-footer-col">
      <h3>Get Started</h3>
      <ul class="footer-links">
        <li><a href="/contact/"{% if page.url == "/contact/" %} aria-current="page"{% endif %}>Request a Demo</a></li>
        <li><a href="/book-a-call/producer-pro/">Book a Call: Producer Pro</a></li>
        <li><a href="/book-a-call/enterprise/">Book a Call: Enterprise</a></li>
      </ul>
    </div>
  </div>
</section>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <img class="footer-brand" src="{{ settings.logo | imgSrc }}" alt="{{ settings.site_name }}, {{ settings.tagline | lower }}" width="126" height="44" loading="lazy">
      <p>{{ settings.footer_text }}</p>
      <a class="button button-primary" href="{{ settings.cta_url }}">{{ settings.cta_label }}</a>
    </div>
    <div class="footer-col">
      <h3>Contact</h3>
      <p>
        <a href="mailto:{{ settings.contact.email }}">{{ settings.contact.email }}</a><br>
        <a href="tel:{{ settings.contact.phone | replace(' ', '') }}">{{ settings.contact.phone }}</a>
      </p>
      <p>
        {% for line in settings.contact.address_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
      </p>
    </div>
    <div class="footer-col">
      <h3>Legal</h3>
      <p>
        {{ settings.legal.company }}<br>
        {{ settings.legal.country }}<br>
        Chamber of Commerce: {{ settings.legal.coc }}<br>
        VAT: {{ settings.legal.vat }}
      </p>
      {% if settings.legal.logo %}<img class="footer-legal-logo" src="{{ settings.legal.logo | imgSrc }}" alt="{{ settings.legal.company }}" width="150" height="28" loading="lazy">{% endif %}
    </div>
    <div class="footer-col">
      <h3>Follow Us</h3>
      <div class="social-links">
        {% if settings.socials.linkedin %}
        <a href="{{ settings.socials.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        {% endif %}
        {% if settings.socials.youtube %}
        <a href="{{ settings.socials.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>
        </a>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {{ "" | year }} {{ settings.site_name }} · A production of {{ settings.legal.company }}, Amsterdam</p>
  </div>
</footer>
