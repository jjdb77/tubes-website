<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <img class="footer-logo" src="{{ settings.logo }}" alt="{{ settings.site_name }} — {{ settings.tagline }}" width="120" height="40" loading="lazy">
      <p>{{ settings.footer_text }}</p>
      <a class="button button-primary" href="{{ settings.cta_url }}">{{ settings.cta_label }}</a>
    </div>
    <div class="footer-col">
      <h3>Contact</h3>
      <p>
        <a href="mailto:{{ settings.contact.email }}">{{ settings.contact.email }}</a><br>
        <a href="tel:{{ settings.contact.phone | replace(' ', '') }}">{{ settings.contact.phone }}</a>
      </p>
      <p>
        {% for line in settings.contact.address_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
      </p>
    </div>
    <div class="footer-col">
      <h3>Legal</h3>
      <p>
        {{ settings.legal.company }}<br>
        {{ settings.legal.country }}<br>
        Chamber of Commerce: {{ settings.legal.coc }}<br>
        VAT: {{ settings.legal.vat }}
      </p>
      {% if settings.legal.logo %}<img class="footer-legal-logo" src="{{ settings.legal.logo }}" alt="{{ settings.legal.company }}" width="150" height="28" loading="lazy">{% endif %}
    </div>
    <div class="footer-col">
      <h3>Follow Us</h3>
      <div class="social-links">
        {% if settings.socials.linkedin %}
        <a href="{{ settings.socials.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        {% endif %}
        {% if settings.socials.youtube %}
        <a href="{{ settings.socials.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>
        </a>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {{ "" | year }} {{ settings.site_name }} · {{ settings.legal.company }}</p>
  </div>
</footer>
