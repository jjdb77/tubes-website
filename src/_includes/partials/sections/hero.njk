<section class="section section-hero theme-{{ section.theme or 'light' }}{% if section.tight %} hero-tight{% endif %}">
  <div class="container hero-grid{% if not section.image and not section.video and not section.promo and not (section.buttons and section.buttons_position == 'side') %} hero-single{% endif %}{% if section.media_below %} hero-stacked{% endif %}">
    <div class="hero-text">
      {% if section.kicker %}<span class="kicker">{{ section.kicker }}</span>{% endif %}
      <h1>{{ section.title | mdInline | safe }}</h1>
      {% if section.subtitle %}<p class="hero-sub">{{ section.subtitle }}</p>{% endif %}
      <div class="rich-text lead">{{ section.text | md | safe }}</div>
      {#- Budget / Plan / Produce onder de tekst, met de drie iconen uit de
          Tubes-app (de groepskoppen van het zijmenu, app/views/shared/
          _nav_group_icon.html.erb): cirkel, zeshoek en driehoek als omlijning
          in de kleur van de fase. Losse SVG's, geen bestand: zo volgen ze de
          kleur van het thema. -#}
      {% if section.steps %}
      {%- set stepShapes = {
        budget: '<circle cx="12" cy="12" r="10"></circle>',
        plan: '<polygon points="12,1.75 20.9,6.9 20.9,17.1 12,22.25 3.1,17.1 3.1,6.9"></polygon>',
        produce: '<polygon points="4,2.5 21.5,12 4,21.5"></polygon>'
      } %}
      <ul class="hero-steps">
        {%- for step in section.steps %}
        <li class="hero-step hero-step-{{ step.key }}">
          <svg class="hero-step-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ stepShapes[step.key] | safe }}</svg>
          <p class="hero-step-name">{{ step.name }}</p>
          <p class="hero-step-text">{{ step.text }}</p>
        </li>
        {%- endfor %}
      </ul>
      {% endif %}
      {% if section.chips and not section.media_below %}
      <ul class="chip-row" aria-label="Production stages">
        {% for chip in section.chips %}
        <li class="chip chip-{{ chip.tone or 'teal' }}">{{ chip.label }}</li>
        {% if not loop.last %}<li class="chip-sep" aria-hidden="true">→</li>{% endif %}
        {% endfor %}
      </ul>
      {% endif %}
      {% if section.buttons and (section.buttons_position != 'side' or section.promo) %}
      <div class="button-row">
        {% for btn in section.buttons %}
        <a class="button {% if loop.first %}button-primary{% else %}button-secondary{% endif %}" href="{{ btn.url }}">{{ btn.label }}</a>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% if section.video %}
    <div class="hero-media">
      <video controls playsinline preload="metadata" {% if section.poster %}poster="{{ section.poster | imgSrc }}"{% endif %} src="{{ section.video }}"></video>
      <span class="viewfinder" aria-hidden="true"></span>
    </div>
    {% elif section.image %}
    <div class="hero-media">
      <img src="{{ section.image | imgSrc }}" alt="{{ section.image_alt or (section.title | plain) }}" {{ section.image | imgSize | safe }} loading="eager" decoding="async" fetchpriority="high">
      <span class="viewfinder" aria-hidden="true"></span>
    </div>
    {% elif section.promo %}
    {#- Reclameblok voor Tubes in de rechterkolom (zie partials/directory-promo.njk);
        de knoppen van de hero staan dan onder de tekst. -#}
    {% set promoVariant = "hero" %}{% include "partials/directory-promo.njk" %}
    {% elif section.buttons and section.buttons_position == 'side' %}
    <div class="hero-actions-side">
      {% for btn in section.buttons %}
      <a class="button {% if loop.first %}button-primary{% else %}button-secondary{% endif %}" href="{{ btn.url }}">{{ btn.label }}</a>
      {% endfor %}
    </div>
    {% endif %}
    {% if section.chips and section.media_below %}
    <ul class="chip-row chip-row-below" aria-label="Production stages">
      {% for chip in section.chips %}
      <li class="chip chip-{{ chip.tone or 'teal' }}">{{ chip.label }}</li>
      {% if not loop.last %}<li class="chip-sep" aria-hidden="true">→</li>{% endif %}
      {% endfor %}
    </ul>
    {% endif %}
  </div>
</section>
