<section class="section theme-{{ section.theme or 'white' }}">
  <div class="container">
    {% if section.heading %}<h2 class="section-heading">{{ section.heading }}</h2>{% endif %}
    {% if section.intro %}<div class="rich-text section-intro">{{ section.intro | md | safe }}</div>{% endif %}
    <div class="compare-grid">
      <div class="compare-card compare-without">
        <h3>{{ section.without_title or "Without Tubes" }}</h3>
        <ul>
          {% for item in section.without_items %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="compare-card compare-with">
        <h3>{{ section.with_title or "With Tubes" }}</h3>
        <ul>
          {% for item in section.with_items %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
