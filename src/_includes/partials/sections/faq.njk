<section class="section theme-{{ section.theme or 'white' }}">
  <div class="container faq-wrap">
    {% if section.heading %}<h2>{{ section.heading }}</h2>{% endif %}
    {% if section.intro %}<div class="rich-text section-intro">{{ section.intro | md | safe }}</div>{% endif %}
    <div class="faq-list">
      {% for item in section.items %}
      <details class="faq-item"{% if loop.first %} open{% endif %}>
        <summary>{{ item.question }}</summary>
        <div class="rich-text faq-answer">{{ item.answer | md | safe }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
  {#- Geen eigen FAQPage hier: de jsonld-filter in eleventy.config.js zet er al
      een in de @graph van layout.njk, over alle faq-secties van de pagina
      samen. Twee FAQPage-blokken op een pagina is dubbelop voor Google. -#}
</section>
