{#- Locatiegids (/compare-film-tv-locations/): zoeken, kaart, fotokaarten en
    1 tot 3 locaties naast elkaar. Data: src/_data/filmlocations.json (CMS:
    "Filmlocaties (locatiegids)"). De incentive per land komt uit locations.json.
    Kaart: Leaflet + OpenStreetMap, pas geladen zodra de kaart in beeld komt
    (staat zo ook in de privacyverklaring). Foto's: Wikimedia Commons-thumbnails
    met maker en licentie per foto, of eigen uploads met toestemming. -#}
{%- set countries = [] -%}
{%- for loc in filmlocations.locations -%}{%- if loc.country not in countries -%}{%- set countries = (countries.push(loc.country), countries) -%}{%- endif -%}{%- endfor -%}
{%- set types = [] -%}
{%- for loc in filmlocations.locations -%}{%- if loc.type not in types -%}{%- set types = (types.push(loc.type), types) -%}{%- endif -%}{%- endfor -%}
<section class="section theme-{{ section.theme or 'light' }} section-locationguide" id="locations">
  <div class="container">
    {% if section.heading %}<h2 class="section-heading">{{ section.heading }}</h2>{% endif %}
    {% if section.intro %}<div class="rich-text section-intro">{{ section.intro | md | safe }}</div>{% endif %}

    <div class="guide-controls">
      <label class="loc-field guide-search-field" for="guide-search">What are you looking for?
        <input type="search" id="guide-search" placeholder="Mountains, hotel, water tank, medieval street ..." autocomplete="off">
      </label>
      <label class="loc-field" for="guide-country">Country
        <select id="guide-country" class="guide-select">
          <option value="">All countries</option>
          {% for c in countries | sort %}<option>{{ c }}</option>{% endfor %}
        </select>
      </label>
      <label class="loc-field" for="guide-type">Type
        <select id="guide-type" class="guide-select">
          <option value="">All types</option>
          {% for t in types | sort %}<option>{{ t }}</option>{% endfor %}
        </select>
      </label>
    </div>
    <p class="guide-count" data-guide-count aria-live="polite"></p>

    <div class="guide-map" data-guide-map>
      <p class="guide-map-note">The map appears here and loads its tiles from OpenStreetMap.</p>
    </div>

    <div class="guide-compare-out" data-guide-compare hidden aria-live="polite"></div>

    <div class="guide-grid" data-guide-grid>
      {% for loc in filmlocations.locations %}
      <article class="guide-card" id="loc-{{ loc.id }}" data-id="{{ loc.id }}" data-country="{{ loc.country }}" data-type="{{ loc.type }}"
               data-search="{{ (loc.name + ' ' + loc.region + ' ' + loc.country + ' ' + loc.type + ' ' + loc.setting + ' ' + loc.known_for) | lower }}">
        {% if loc.photo and loc.photo.thumb %}
        <figure class="guide-photo">
          <img src="{{ loc.photo.thumb }}" alt="{{ loc.name }}, {{ loc.region }}" loading="lazy" decoding="async" referrerpolicy="no-referrer">
          <figcaption>Photo: {{ loc.photo.author }} ({{ loc.photo.license }}), <a href="{{ loc.photo.file_page }}" target="_blank" rel="noopener">Wikimedia Commons</a></figcaption>
        </figure>
        {% else %}
        <div class="guide-photo guide-photo-empty"><span>{{ loc.type }}</span></div>
        {% endif %}
        <div class="guide-card-body">
          <h3>{{ loc.name }}</h3>
          <p class="guide-meta">{{ loc.region }}, {{ loc.country }}</p>
          <p><span class="loc-tag guide-type-tag">{{ loc.type }}</span></p>
          <p class="guide-setting">{{ loc.setting }}</p>
          {% if loc.known_for %}<p class="guide-known"><strong>Seen in:</strong> {{ loc.known_for }}</p>{% endif %}
          <p class="guide-links">
            {% if loc.official_url %}<a href="{{ loc.official_url }}" target="_blank" rel="noopener">Official site</a>{% endif %}
            {% if loc.commission_url %}<a href="{{ loc.commission_url }}" target="_blank" rel="noopener">Film commission</a>{% endif %}
            <a data-incentive-for="{{ loc.country }}" href="/compare-film-incentives/" hidden></a>
          </p>
          <label class="guide-pick"><input type="checkbox" data-guide-check value="{{ loc.id }}"> <span>Compare</span></label>
        </div>
      </article>
      {% endfor %}
    </div>
    <p class="loc-empty guide-none" hidden>Nothing matches. Try fewer filters, or <a href="#request-location">suggest a location</a>.</p>

    <div class="guide-bar" data-guide-bar hidden>
      <span data-guide-bar-label></span>
      <button type="button" class="button button-primary" data-guide-bar-btn>Compare side by side</button>
      <button type="button" class="button button-secondary" data-guide-bar-clear>Clear</button>
    </div>

    <div class="loc-request" id="request-location">
      <div>
        <h3>{{ section.request_heading or "Is your location not listed? Suggest it" }}</h3>
        <div class="rich-text">{{ (section.request_text or "Own or manage a location or studio, or missing a place you have shot at? Tell us what and where it is, add a link, and we list it for free with verified details. Photos must be yours or carry a licence we can honour, with the photographer credited.") | md | safe }}</div>
      </div>
      <form class="contact-form loc-request-form" method="POST" action="{{ settings.form_endpoint }}" data-endpoint="{{ settings.form_endpoint }}" data-email="{{ settings.contact.email }}">
        <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">
        <div class="form-row">
          <label>First name <span class="req">(required)</span>
            <input type="text" name="first_name" autocomplete="given-name" required>
          </label>
          <label>Last name <span class="req">(required)</span>
            <input type="text" name="last_name" autocomplete="family-name" required>
          </label>
        </div>
        <label>Email <span class="req">(required)</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label>Location or studio, and where it is <span class="req">(required)</span>
          <input type="text" name="location" required placeholder="For example: converted paper mill, Ghent, Belgium">
        </label>
        <label>Anything we should know?
          <textarea name="notes" rows="3" placeholder="A link, what has shot there, whether you own or manage it"></textarea>
        </label>
        <input type="hidden" name="message" value="">
        <button type="submit" class="button button-primary">Suggest this location</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <script type="application/json" id="guide-data">{{ filmlocations | dump | safe }}</script>
  <script type="application/json" id="guide-incentives">{{ locations | dump | safe }}</script>
  <script>
  (() => {
    const root = document.querySelector(".section-locationguide");
    if (!root) return;
    const data = JSON.parse(document.getElementById("guide-data").textContent);
    const incentives = JSON.parse(document.getElementById("guide-incentives").textContent);
    const MAX = 3;
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const byId = Object.fromEntries(data.locations.map((l) => [l.id, l]));

    // Incentive per land, uit de incentivetabel ("Spain (mainland)" -> "Spain")
    const incentiveByCountry = {};
    for (const inc of incentives.locations || []) {
      const key = inc.name.split(" (")[0];
      if (!incentiveByCountry[key]) incentiveByCountry[key] = inc;
    }
    for (const a of root.querySelectorAll("[data-incentive-for]")) {
      const inc = incentiveByCountry[a.dataset.incentiveFor];
      if (inc) { a.textContent = "Incentive: " + inc.rate_label; a.hidden = false; }
    }

    // Zoeken en filteren
    const q = root.querySelector("#guide-search");
    const country = root.querySelector("#guide-country");
    const type = root.querySelector("#guide-type");
    const cards = [...root.querySelectorAll(".guide-card")];
    const countEl = root.querySelector("[data-guide-count]");
    const noneEl = root.querySelector(".guide-none");
    const visibleIds = () => cards.filter((c) => !c.hidden).map((c) => c.dataset.id);

    const applyFilters = () => {
      const needle = q.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const ok = (!country.value || card.dataset.country === country.value) &&
                   (!type.value || card.dataset.type === type.value) &&
                   (!needle || card.dataset.search.includes(needle));
        card.hidden = !ok;
        if (ok) shown++;
      }
      countEl.textContent = shown + " of " + cards.length + " locations shown";
      noneEl.hidden = shown > 0;
      updateMap();
    };
    q.addEventListener("input", applyFilters);
    country.addEventListener("change", applyFilters);
    type.addEventListener("change", applyFilters);

    // Kaart: Leaflet + OpenStreetMap, pas laden zodra de kaart in beeld komt
    const mapEl = root.querySelector("[data-guide-map]");
    let map = null, markerLayer = null, leafletLoading = false;
    const updateMap = () => {
      if (!map || !markerLayer) return;
      markerLayer.clearLayers();
      const ids = new Set(visibleIds());
      for (const loc of data.locations) {
        if (!ids.has(loc.id) || loc.lat == null || loc.lng == null) continue;
        const m = L.circleMarker([loc.lat, loc.lng], { radius: 7, color: "#0E9C88", weight: 2, fillColor: "#0E9C88", fillOpacity: 0.55 });
        m.bindPopup(`<strong>${esc(loc.name)}</strong><br>${esc(loc.region)}, ${esc(loc.country)}<br><a href="#loc-${esc(loc.id)}" data-goto="${esc(loc.id)}">Show details</a>`);
        markerLayer.addLayer(m);
      }
    };
    const initMap = () => {
      if (map || leafletLoading) return;
      leafletLoading = true;
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css";
      document.head.appendChild(css);
      const js = document.createElement("script");
      js.src = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js";
      js.onload = () => {
        mapEl.innerHTML = "";
        map = L.map(mapEl, { scrollWheelZoom: false }).setView([52, 12], 4);
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 17,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors'
        }).addTo(map);
        markerLayer = L.layerGroup().addTo(map);
        updateMap();
      };
      document.head.appendChild(js);
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { initMap(); io.disconnect(); }
      }, { rootMargin: "200px" });
      io.observe(mapEl);
    } else {
      initMap();
    }
    mapEl.addEventListener("click", (e) => {
      const link = e.target.closest("[data-goto]");
      if (!link) return;
      e.preventDefault();
      const card = document.getElementById("loc-" + link.dataset.goto);
      if (card) {
        card.scrollIntoView({ behavior: "smooth", block: "center" });
        card.classList.add("is-highlight");
        setTimeout(() => card.classList.remove("is-highlight"), 2400);
      }
    });

    // Vergelijken: 1 tot 3 locaties naast elkaar
    const checks = [...root.querySelectorAll("[data-guide-check]")];
    const bar = root.querySelector("[data-guide-bar]");
    const barLabel = root.querySelector("[data-guide-bar-label]");
    const out = root.querySelector("[data-guide-compare]");
    const chosen = () => checks.filter((c) => c.checked).map((c) => byId[c.value]).filter(Boolean);

    const syncBar = () => {
      const picks = chosen();
      for (const c of checks) c.disabled = !c.checked && picks.length >= MAX;
      bar.hidden = picks.length === 0;
      barLabel.textContent = picks.length === 1 ? picks[0].name : picks.map((p) => p.name).join("  ·  ");
      if (picks.length === 0) { out.hidden = true; out.innerHTML = ""; }
    };
    const renderCompare = () => {
      const picks = chosen();
      if (!picks.length) return;
      const cell = (fn) => picks.map((p) => `<td>${fn(p)}</td>`).join("");
      const row = (label, fn) => `<tr><th scope="row">${label}</th>${cell(fn)}</tr>`;
      out.innerHTML = `
        <h3>Side by side</h3>
        <div class="loc-compare-wrap" tabindex="0">
        <table class="loc-compare loc-compare-${picks.length}">
          <thead><tr><th scope="col"><span class="visually-hidden">Property</span></th>${picks.map((p) => `<th scope="col">${esc(p.name)}<small>${esc(p.region)}, ${esc(p.country)}</small></th>`).join("")}</tr></thead>
          <tbody>
            ${row("Photo", (p) => p.photo && p.photo.thumb
              ? `<img class="guide-compare-photo" src="${esc(p.photo.thumb)}" alt="${esc(p.name)}" loading="lazy" referrerpolicy="no-referrer"><small>Photo: ${esc(p.photo.author)} (${esc(p.photo.license)})</small>`
              : "<small>No photo yet</small>")}
            ${row("Type", (p) => `<span class="loc-tag">${esc(p.type)}</span>`)}
            ${row("What it offers", (p) => esc(p.setting))}
            ${row("Seen in", (p) => esc(p.known_for || ""))}
            ${row("Incentive in this country", (p) => {
              const inc = incentiveByCountry[p.country];
              return inc ? `<strong>${esc(inc.rate_label)}</strong><small>${esc(inc.scheme)}</small><small><a href="/compare-film-incentives/">Full incentive comparison</a></small>` : `<small>Not in our incentive table yet. <a href="/compare-film-incentives/">See the comparison</a></small>`;
            })}
            ${row("Links", (p) => [
              p.official_url ? `<a href="${esc(p.official_url)}" target="_blank" rel="noopener">Official site</a>` : "",
              p.commission_url ? `<a href="${esc(p.commission_url)}" target="_blank" rel="noopener">Film commission</a>` : "",
            ].filter(Boolean).join("<br>"))}
          </tbody>
        </table>
        </div>
        <p class="loc-disclaimer">Details checked on ${esc(data.updated)}; always confirm access, permits and availability with the location or the film commission. Not affiliated with Tubes.</p>`;
      out.hidden = false;
      out.scrollIntoView({ behavior: "smooth", block: "start" });
    };
    root.addEventListener("change", (e) => { if (e.target.matches("[data-guide-check]")) { syncBar(); if (!out.hidden) renderCompare(); } });
    root.querySelector("[data-guide-bar-btn]").addEventListener("click", renderCompare);
    root.querySelector("[data-guide-bar-clear]").addEventListener("click", () => { for (const c of checks) c.checked = false; syncBar(); });

    // Aanvraagformulier: zelfde berichtprefix als op de incentivepagina, dus
    // dezelfde mail naar LOCATION_EMAIL via server.js
    const request = root.querySelector(".loc-request-form");
    if (request) {
      request.addEventListener("submit", () => {
        const location = request.querySelector('[name="location"]').value.trim();
        const notes = request.querySelector('[name="notes"]').value.trim();
        request.querySelector('[name="message"]').value = "Location request: " + location + (notes ? "\n\n" + notes : "");
      });
    }

    applyFilters();
    syncBar();
  })();
  </script>
</section>
