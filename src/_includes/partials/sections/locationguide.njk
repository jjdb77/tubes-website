{#- Locatiegids (/compare-film-tv-locations/): zoeken, kaart, fotokaarten en
    2 tot 3 locaties naast elkaar, met voorkeurslijst (localStorage) en een
    kaart/lijst-schakelaar. Data: src/_data/filmlocations.json (CMS:
    "Filmlocaties (locatiegids)"). Incentive per land komt uit locations.json.
    Kaart: Leaflet + OpenStreetMap, pas geladen zodra hij in beeld komt.
    Foto's: Wikimedia Commons met maker en licentie, of uploads met toestemming.
    Winnaarslogica in de vergelijking: alleen markeren bij verschil én minstens
    twee ingevulde kolommen; bij "vergunning nodig" wint nee; lege rijen vallen weg. -#}
{%- set countries = [] -%}
{%- for loc in filmlocations.locations -%}{%- if loc.country not in countries -%}{%- set countries = (countries.push(loc.country), countries) -%}{%- endif -%}{%- endfor -%}
{%- set types = [] -%}
{%- for loc in filmlocations.locations -%}{%- if loc.type not in types -%}{%- set types = (types.push(loc.type), types) -%}{%- endif -%}{%- endfor -%}
<section class="section theme-{{ section.theme or 'light' }} section-locationguide" id="locations">
  <div class="container">
    {% if section.heading %}<h2 class="section-heading">{{ section.heading }}</h2>{% endif %}
    {% if section.intro %}<div class="rich-text section-intro">{{ section.intro | md | safe }}</div>{% endif %}

    <div class="guide-controls">
      <div class="loc-field guide-search-field">
        <label for="guide-search">What are you looking for?</label>
        <input type="search" id="guide-search" placeholder="Try: industrial hall with high ceilings near Amsterdam" autocomplete="off">
        <div class="guide-ai-row">
          <button type="button" class="guide-ai-btn" data-ai-btn>Let AI turn this into filters</button>
          <span class="guide-ai-status" data-ai-status role="status"></span>
        </div>
      </div>
      <label class="loc-field" for="guide-country">Country
        <select id="guide-country" class="guide-select">
          <option value="">All countries</option>
          {% for c in countries | sort %}<option>{{ c }}</option>{% endfor %}
        </select>
      </label>
      <label class="loc-field" for="guide-type">Type
        <select id="guide-type" class="guide-select">
          <option value="">All types</option>
          {% for t in types | sort %}<option>{{ t }}</option>{% endfor %}
        </select>
      </label>
    </div>

    <ul class="guide-chips" data-ai-chips hidden aria-label="Recognised filters"></ul>

    <div class="guide-toolbar">
      <div class="guide-pills" role="group" aria-label="Which list">
        <button type="button" class="guide-pill is-active" data-list="all">All locations</button>
        <button type="button" class="guide-pill" data-list="favs">My shortlist <span data-fav-count></span></button>
      </div>
      <p class="guide-count" data-guide-count aria-live="polite"></p>
      <div class="guide-pills" role="group" aria-label="View">
        <button type="button" class="guide-pill is-active" data-view="cards">Cards</button>
        <button type="button" class="guide-pill" data-view="list">List</button>
      </div>
    </div>

    <div class="guide-map" data-guide-map>
      <p class="guide-map-note">The map appears here and loads its tiles from OpenStreetMap.</p>
    </div>

    <div class="guide-compare-out" data-guide-compare hidden aria-live="polite"></div>

    <div class="guide-layout">
      <div class="guide-main">
        <div class="guide-grid" data-guide-grid>
          {% for loc in filmlocations.locations %}
          <article class="guide-card" id="loc-{{ loc.id }}" data-id="{{ loc.id }}" data-country="{{ loc.country }}" data-type="{{ loc.type }}"
                   data-search="{{ (loc.name + ' ' + loc.region + ' ' + loc.country + ' ' + loc.type + ' ' + loc.setting + ' ' + loc.known_for) | lower }}">
            {% if loc.photo and loc.photo.thumb %}
            <figure class="guide-photo">
              <img src="{{ loc.photo.thumb }}" alt="{{ loc.name }}, {{ loc.region }}" loading="lazy" decoding="async" referrerpolicy="no-referrer">
              <figcaption>Photo: {{ loc.photo.author }} ({{ loc.photo.license }}), <a href="{{ loc.photo.file_page }}" target="_blank" rel="noopener">Wikimedia Commons</a></figcaption>
            </figure>
            {% else %}
            <div class="guide-photo guide-photo-empty"><span>{{ loc.type }}</span></div>
            {% endif %}
            <button type="button" class="guide-fav" data-fav aria-pressed="false" aria-label="Add {{ loc.name }} to my shortlist"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.9-10-9.2C.4 8.9 2 5 5.6 5c2 0 3.4 1.1 4.4 2.5C11 6.1 12.4 5 14.4 5 18 5 19.6 8.9 22 11.8 19.5 16.1 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></button>
            <div class="guide-card-body">
              <h3>{{ loc.name }}</h3>
              <p class="guide-meta">{{ loc.region }}, {{ loc.country }}</p>
              <p><span class="loc-tag guide-type-tag">{{ loc.type }}</span></p>
              <p class="guide-setting">{{ loc.setting }}</p>
              {% if loc.known_for %}<p class="guide-known"><strong>Seen in:</strong> {{ loc.known_for }}</p>{% endif %}
              <p class="guide-links">
                {% if loc.official_url %}<a href="{{ loc.official_url }}" target="_blank" rel="noopener">Official site</a>{% endif %}
                {% if loc.commission_url %}<a href="{{ loc.commission_url }}" target="_blank" rel="noopener">Film commission</a>{% endif %}
                <a data-incentive-for="{{ loc.country }}" href="/compare-film-incentives/" hidden></a>
              </p>
              <label class="guide-pick"><input type="checkbox" data-guide-check value="{{ loc.id }}"> <span>Compare</span></label>
            </div>
          </article>
          {% endfor %}
        </div>
        <p class="loc-empty guide-none" hidden>Nothing matches. Try fewer filters, or <a href="#request-location">suggest a location</a>.</p>
      </div>

      <aside class="guide-aside" data-guide-aside aria-label="Your comparison">
        <h3>Side by side</h3>
        <ol class="guide-slots" data-guide-slots></ol>
        <button type="button" class="button button-primary" data-guide-compare-btn disabled>Compare side by side</button>
        <button type="button" class="button button-secondary" data-guide-clear hidden>Clear</button>
        <p class="guide-aside-note">Pick two or three locations with the Compare button on a card.</p>
      </aside>
    </div>

    <div class="loc-request" id="request-location">
      <div>
        <h3>{{ section.request_heading or "Is your location not listed? Suggest it" }}</h3>
        <div class="rich-text">{{ (section.request_text or "Own or manage a location or studio, or missing a place you have shot at? Tell us what and where it is, add a link, and we list it for free with verified details. We only publish what a venue itself publishes, with the source; photos must be yours or carry a licence we can honour, with the photographer credited.") | md | safe }}</div>
      </div>
      <form class="contact-form loc-request-form" method="POST" action="{{ settings.form_endpoint }}" data-endpoint="{{ settings.form_endpoint }}" data-email="{{ settings.contact.email }}">
        <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">
        <div class="form-row">
          <label>First name <span class="req">(required)</span>
            <input type="text" name="first_name" autocomplete="given-name" required>
          </label>
          <label>Last name <span class="req">(required)</span>
            <input type="text" name="last_name" autocomplete="family-name" required>
          </label>
        </div>
        <label>Email <span class="req">(required)</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label>Location or studio, and where it is <span class="req">(required)</span>
          <input type="text" name="location" required placeholder="For example: converted paper mill, Ghent, Belgium">
        </label>
        <label>Anything we should know?
          <textarea name="notes" rows="3" placeholder="A link, what has shot there, whether you own or manage it"></textarea>
        </label>
        <input type="hidden" name="message" value="">
        <button type="submit" class="button button-primary">Suggest this location</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <script type="application/json" id="guide-data">{{ filmlocations | dump | safe }}</script>
  <script type="application/json" id="guide-incentives">{{ locations | dump | safe }}</script>
  <script>
  (() => {
    const root = document.querySelector(".section-locationguide");
    if (!root) return;
    const data = JSON.parse(document.getElementById("guide-data").textContent);
    const incentives = JSON.parse(document.getElementById("guide-incentives").textContent);
    const MAX = 3;
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const byId = Object.fromEntries(data.locations.map((l) => [l.id, l]));

    // Incentive per land, uit de incentivetabel ("Spain (mainland)" -> "Spain")
    const incentiveByCountry = {};
    for (const inc of incentives.locations || []) {
      const key = inc.name.split(" (")[0];
      if (!incentiveByCountry[key]) incentiveByCountry[key] = inc;
    }
    for (const a of root.querySelectorAll("[data-incentive-for]")) {
      const inc = incentiveByCountry[a.dataset.incentiveFor];
      if (inc) { a.textContent = "Incentive: " + inc.rate_label; a.hidden = false; }
    }

    // Voorkeurslijst in de browser zelf (localStorage); werkt ook zonder
    const favKey = "tubes-location-shortlist";
    const loadFavs = () => { try { return new Set(JSON.parse(localStorage.getItem(favKey) || "[]")); } catch { return new Set(); } };
    const saveFavs = () => { try { localStorage.setItem(favKey, JSON.stringify([...favs])); } catch {} };
    const favs = loadFavs();

    const q = root.querySelector("#guide-search");
    const country = root.querySelector("#guide-country");
    const type = root.querySelector("#guide-type");
    const cards = [...root.querySelectorAll(".guide-card")];
    const countEl = root.querySelector("[data-guide-count]");
    const favCountEl = root.querySelector("[data-fav-count]");
    const noneEl = root.querySelector(".guide-none");
    const grid = root.querySelector("[data-guide-grid]");
    let listMode = "all";
    let aiTerms = [];

    const syncFavButtons = () => {
      for (const card of cards) {
        const on = favs.has(card.dataset.id);
        const btn = card.querySelector("[data-fav]");
        btn.setAttribute("aria-pressed", on ? "true" : "false");
        btn.classList.toggle("is-on", on);
      }
      favCountEl.textContent = favs.size ? "(" + favs.size + ")" : "";
    };

    const visibleIds = () => cards.filter((c) => !c.hidden).map((c) => c.dataset.id);
    const applyFilters = () => {
      const needle = q.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const ok = (listMode === "all" || favs.has(card.dataset.id)) &&
                   (!country.value || card.dataset.country === country.value) &&
                   (!type.value || card.dataset.type === type.value) &&
                   (!needle || card.dataset.search.includes(needle)) &&
                   aiTerms.every((t) => card.dataset.search.includes(t));
        card.hidden = !ok;
        if (ok) shown++;
      }
      countEl.textContent = shown + " of " + cards.length + " locations";
      noneEl.hidden = shown > 0;
      updateMap();
    };
    q.addEventListener("input", applyFilters);
    country.addEventListener("change", applyFilters);
    type.addEventListener("change", applyFilters);

    // AI-zoeken: de zoekvraag gaat naar de eigen server, die er via OpenAI
    // alleen filters van maakt (de database gaat nooit mee). De herkende
    // filters staan als bewerkbare chips boven de resultaten. Faalt de call
    // of is er geen sleutel, dan blijft het gewone tekstzoeken gewoon werken.
    const aiBtn = root.querySelector("[data-ai-btn]");
    const aiStatus = root.querySelector("[data-ai-status]");
    const aiChips = root.querySelector("[data-ai-chips]");

    const renderChips = () => {
      const chips = [];
      if (country.value) chips.push({ kind: "country", label: country.value });
      if (type.value) chips.push({ kind: "type", label: type.value });
      for (const t of aiTerms) chips.push({ kind: "term", label: t });
      aiChips.hidden = chips.length === 0;
      aiChips.innerHTML = chips.map((c) =>
        `<li class="guide-chip"><span>${esc(c.label)}</span><button type="button" data-chip-kind="${c.kind}" data-chip-value="${esc(c.label)}" aria-label="Remove filter ${esc(c.label)}">&times;</button></li>`).join("");
    };
    aiChips.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-chip-kind]");
      if (!btn) return;
      if (btn.dataset.chipKind === "country") country.value = "";
      else if (btn.dataset.chipKind === "type") type.value = "";
      else aiTerms = aiTerms.filter((t) => t !== btn.dataset.chipValue);
      renderChips(); applyFilters();
    });
    country.addEventListener("change", renderChips);
    type.addEventListener("change", renderChips);

    const askAI = async () => {
      const query = q.value.trim();
      if (!query) { aiStatus.textContent = "Type what you are looking for first."; return; }
      aiBtn.disabled = true;
      aiStatus.textContent = "Reading your search…";
      try {
        const r = await fetch("/api/location-search", {
          method: "POST",
          body: new URLSearchParams({ q: query }),
          headers: { Accept: "application/json" },
        });
        const body = await r.json().catch(() => ({}));
        if (r.ok && body.ok && body.filters) {
          const f = body.filters;
          if (f.country && [...country.options].some((o) => o.value === f.country)) country.value = f.country;
          if (f.type && [...type.options].some((o) => o.value === f.type)) type.value = f.type;
          aiTerms = f.terms || [];
          q.value = "";
          aiStatus.textContent = "These filters were recognised; remove a chip to widen the search.";
        } else {
          aiStatus.textContent = "AI search is not available right now; showing plain text matches instead.";
        }
      } catch {
        aiStatus.textContent = "AI search is not available right now; showing plain text matches instead.";
      }
      aiBtn.disabled = false;
      renderChips(); applyFilters();
    };
    aiBtn.addEventListener("click", askAI);
    q.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); askAI(); } });

    // Pills: alle locaties / voorkeurslijst, en kaarten / lijst
    for (const pill of root.querySelectorAll("[data-list]")) {
      pill.addEventListener("click", () => {
        listMode = pill.dataset.list;
        for (const p of root.querySelectorAll("[data-list]")) p.classList.toggle("is-active", p === pill);
        applyFilters();
      });
    }
    for (const pill of root.querySelectorAll("[data-view]")) {
      pill.addEventListener("click", () => {
        for (const p of root.querySelectorAll("[data-view]")) p.classList.toggle("is-active", p === pill);
        grid.classList.toggle("is-list", pill.dataset.view === "list");
      });
    }

    // Hartje op de kaarten
    grid.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-fav]");
      if (!btn) return;
      const id = btn.closest(".guide-card").dataset.id;
      favs.has(id) ? favs.delete(id) : favs.add(id);
      saveFavs(); syncFavButtons();
      if (listMode === "favs") applyFilters();
    });

    // Kaart: Leaflet + OpenStreetMap, pas laden zodra hij in beeld komt
    const mapEl = root.querySelector("[data-guide-map]");
    let map = null, markerLayer = null, leafletLoading = false;
    const updateMap = () => {
      if (!map || !markerLayer) return;
      markerLayer.clearLayers();
      const ids = new Set(visibleIds());
      for (const loc of data.locations) {
        if (!ids.has(loc.id) || loc.lat == null || loc.lng == null) continue;
        const m = L.circleMarker([loc.lat, loc.lng], { radius: 7, color: "#0E9C88", weight: 2, fillColor: "#0E9C88", fillOpacity: 0.55 });
        m.bindPopup(`<strong>${esc(loc.name)}</strong><br>${esc(loc.region)}, ${esc(loc.country)}<br><a href="#loc-${esc(loc.id)}" data-goto="${esc(loc.id)}">Show details</a>`);
        markerLayer.addLayer(m);
      }
    };
    const initMap = () => {
      if (map || leafletLoading) return;
      leafletLoading = true;
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css";
      document.head.appendChild(css);
      const js = document.createElement("script");
      js.src = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js";
      js.onload = () => {
        mapEl.innerHTML = "";
        map = L.map(mapEl, { scrollWheelZoom: false }).setView([52, 12], 4);
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 17,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors'
        }).addTo(map);
        markerLayer = L.layerGroup().addTo(map);
        updateMap();
      };
      document.head.appendChild(js);
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { initMap(); io.disconnect(); }
      }, { rootMargin: "200px" });
      io.observe(mapEl);
    } else {
      initMap();
    }
    mapEl.addEventListener("click", (e) => {
      const link = e.target.closest("[data-goto]");
      if (!link) return;
      e.preventDefault();
      const card = document.getElementById("loc-" + link.dataset.goto);
      if (card) {
        card.scrollIntoView({ behavior: "smooth", block: "center" });
        card.classList.add("is-highlight");
        setTimeout(() => card.classList.remove("is-highlight"), 2400);
      }
    });

    // Vergelijken: A/B/C-paneel; knop pas actief vanaf twee locaties
    const checks = [...root.querySelectorAll("[data-guide-check]")];
    const aside = root.querySelector("[data-guide-aside]");
    const slots = root.querySelector("[data-guide-slots]");
    const compareBtn = root.querySelector("[data-guide-compare-btn]");
    const clearBtn = root.querySelector("[data-guide-clear]");
    const out = root.querySelector("[data-guide-compare]");
    const chosen = () => checks.filter((c) => c.checked).map((c) => byId[c.value]).filter(Boolean);

    const syncPanel = () => {
      const picks = chosen();
      for (const c of checks) c.disabled = !c.checked && picks.length >= MAX;
      const letters = ["A", "B", "C"];
      slots.innerHTML = letters.map((letter, i) => {
        const p = picks[i];
        return `<li class="guide-slot${p ? " is-filled" : ""}"><span class="guide-slot-letter">${letter}</span>${p ? `<span class="guide-slot-name">${esc(p.name)}</span><button type="button" class="guide-slot-x" data-unpick="${esc(p.id)}" aria-label="Remove ${esc(p.name)}">&times;</button>` : '<span class="guide-slot-empty">Empty</span>'}</li>`;
      }).join("");
      compareBtn.disabled = picks.length < 2;
      clearBtn.hidden = picks.length === 0;
      aside.classList.toggle("has-picks", picks.length > 0);
      if (picks.length < 2) { out.hidden = true; out.innerHTML = ""; }
    };
    slots.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-unpick]");
      if (!btn) return;
      const check = checks.find((c) => c.value === btn.dataset.unpick);
      if (check) check.checked = false;
      syncPanel();
      if (!out.hidden) renderCompare();
    });

    // Winnaarslogica: alleen markeren bij verschil en minstens twee ingevulde
    // kolommen; bij "vergunning nodig" wint nee. Lege rijen vallen weg.
    const filled = (v) => v !== undefined && v !== null && String(v).trim() !== "";
    const winnerIndex = (vals, mode) => {
      const present = vals.map((v, i) => [v, i]).filter(([v]) => filled(v));
      if (present.length < 2) return -1;
      let mapped;
      if (mode === "lower" || mode === "higher") {
        mapped = present.map(([v, i]) => [Number(String(v).replace(/[^\d.]/g, "")), i]).filter(([n]) => !isNaN(n));
        if (mapped.length < 2) return -1;
        if (new Set(mapped.map(([n]) => n)).size < 2) return -1;
        mapped.sort((a, b) => (mode === "lower" ? a[0] - b[0] : b[0] - a[0]));
        return mapped[0][1];
      }
      if (mode === "no-wins") {
        const no = present.filter(([v]) => /^no/i.test(String(v)));
        const yes = present.filter(([v]) => /^yes/i.test(String(v)));
        if (!no.length || !yes.length) return -1;
        return no[0][1];
      }
      return -1;
    };

    const renderCompare = () => {
      const picks = chosen();
      if (picks.length < 2) return;
      const row = (label, fn, opts = {}) => {
        const vals = picks.map(fn);
        if (opts.optional && !vals.some((v) => filled(v && v.raw !== undefined ? v.raw : v))) return "";
        const win = opts.winner ? winnerIndex(picks.map((p) => p[opts.key]), opts.winner) : -1;
        const cells = vals.map((v, i) => `<td${i === win ? ' class="is-top"' : ""}>${(v && v.html !== undefined) ? v.html : (filled(v) ? esc(v) : '<span class="guide-dash">&ndash;</span>')}</td>`).join("");
        return `<tr><th scope="row">${label}</th>${cells}</tr>`;
      };
      out.innerHTML = `
        <h3>Side by side</h3>
        <div class="loc-compare-wrap" tabindex="0">
        <table class="loc-compare loc-compare-${picks.length}">
          <thead><tr><th scope="col"><span class="visually-hidden">Property</span></th>${picks.map((p) => `<th scope="col">${esc(p.name)}<small>${esc(p.region)}, ${esc(p.country)}</small></th>`).join("")}</tr></thead>
          <tbody>
            ${row("Photo", (p) => ({ raw: p.photo, html: p.photo && p.photo.thumb
              ? `<img class="guide-compare-photo" src="${esc(p.photo.thumb)}" alt="${esc(p.name)}" loading="lazy" referrerpolicy="no-referrer"><small>Photo: ${esc(p.photo.author)} (${esc(p.photo.license)})</small>`
              : "<small>No photo yet</small>" }))}
            ${row("Type", (p) => ({ raw: p.type, html: `<span class="loc-tag">${esc(p.type)}</span>` }))}
            ${row("What it offers", (p) => p.setting)}
            ${row("Published price", (p) => p.price_note, { optional: true, key: "price_eur_day", winner: "lower" })}
            ${row("Capacity", (p) => p.capacity, { optional: true, key: "capacity", winner: "higher" })}
            ${row("Facilities", (p) => p.facilities, { optional: true })}
            ${row("Suitability for filming", (p) => p.suitability, { optional: true })}
            ${row("Permit needed", (p) => p.permit_needed, { optional: true, key: "permit_needed", winner: "no-wins" })}
            ${row("Logistics", (p) => p.logistics, { optional: true })}
            ${row("Seen in", (p) => p.known_for, { optional: true })}
            ${row("Incentive in this country", (p) => {
              const inc = incentiveByCountry[p.country];
              return { raw: true, html: inc ? `<strong>${esc(inc.rate_label)}</strong><small>${esc(inc.scheme)}</small><small><a href="/compare-film-incentives/">Full incentive comparison</a></small>` : `<small>Not in our incentive table yet. <a href="/compare-film-incentives/">See the comparison</a></small>` };
            })}
            ${row("Links", (p) => ({ raw: true, html: [
              p.official_url ? `<a href="${esc(p.official_url)}" target="_blank" rel="noopener">Official site</a>` : "",
              p.commission_url ? `<a href="${esc(p.commission_url)}" target="_blank" rel="noopener">Film commission</a>` : "",
              ...(p.source_urls || []).map((u, i) => `<a href="${esc(u)}" target="_blank" rel="noopener">Source ${i + 1}</a>`),
            ].filter(Boolean).join("<br>") }))}
          </tbody>
        </table>
        </div>
        <p class="loc-disclaimer">Only what a venue publishes itself is listed; a dash means not published, not zero. Details checked on ${esc(data.updated)}; always confirm access, permits and availability with the location or the film commission. Locations are not affiliated with Tubes.</p>`;
      out.hidden = false;
      out.scrollIntoView({ behavior: "smooth", block: "start" });
    };
    root.addEventListener("change", (e) => { if (e.target.matches("[data-guide-check]")) { syncPanel(); if (!out.hidden) renderCompare(); } });
    compareBtn.addEventListener("click", renderCompare);
    clearBtn.addEventListener("click", () => { for (const c of checks) c.checked = false; syncPanel(); });

    // Suggestieformulier: zelfde berichtprefix als op de incentivepagina,
    // dus dezelfde mail naar LOCATION_EMAIL via server.js
    const request = root.querySelector(".loc-request-form");
    if (request) {
      request.addEventListener("submit", () => {
        const location = request.querySelector('[name="location"]').value.trim();
        const notes = request.querySelector('[name="notes"]').value.trim();
        request.querySelector('[name="message"]').value = "Location request: " + location + (notes ? "\n\n" + notes : "");
      });
    }

    syncFavButtons();
    applyFilters();
    syncPanel();
  })();
  </script>
</section>
