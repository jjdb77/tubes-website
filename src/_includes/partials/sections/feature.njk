{%- from "partials/step-icon.njk" import stepIcon -%}
<section class="section theme-{{ section.theme or 'light' }}{% if section.media_large %} section-feature-large-media{% endif %}">
  <div class="container feature-grid{% if section.media_position == 'left' %} media-left{% endif %}{% if not section.image and not section.video %} feature-single{% endif %}">
    <div class="feature-text">
      {#- section.step (budget/plan/produce) zet het icoon van die stap uit de
          Tubes-app voor de kop, in de kleur van de stap. -#}
      {% if section.heading %}<h2{% if section.step %} class="step-heading step-{{ section.step }}"{% endif %}>{% if section.step %}{{ stepIcon(section.step) }}{% endif %}{{ section.heading }}</h2>{% endif %}
      {% if section.lead %}<p class="col-lead">{{ section.lead }}</p>{% endif %}
      <div class="rich-text">{{ section.text | md | safe }}</div>
      {% if section.button %}
      <div class="button-row"><a class="button button-primary" href="{{ section.button.url }}">{{ section.button.label }}</a></div>
      {% endif %}
    </div>
    {% if section.video %}
    <div class="feature-media">
      <video controls playsinline preload="metadata" {% if section.ambient %}autoplay muted loop{% endif %} {% if section.poster %}poster="{{ section.poster | imgSrc }}"{% endif %} src="{{ section.video }}"></video>
      {% if section.media_caption %}<p class="media-caption">{{ section.media_caption }}</p>{% endif %}
    </div>
    {% elif section.image %}
    <div class="feature-media{% if section.media_large %} feature-media-large{% endif %}">
      <img src="{{ section.image | imgSrc }}" alt="{{ section.image_alt or section.heading }}" {{ section.image | imgSize | safe }} loading="lazy" decoding="async">
      {% if section.media_caption %}<p class="media-caption">{{ section.media_caption }}</p>{% endif %}
    </div>
    {% endif %}
  </div>
</section>
