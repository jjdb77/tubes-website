<section class="section theme-{{ section.theme or 'light' }}">
  <div class="container feature-grid{% if section.media_position == 'left' %} media-left{% endif %}{% if not section.image and not section.video %} feature-single{% endif %}">
    <div class="feature-text">
      {% if section.heading %}<h2>{{ section.heading }}</h2>{% endif %}
      {% if section.lead %}<p class="col-lead">{{ section.lead }}</p>{% endif %}
      <div class="rich-text">{{ section.text | md | safe }}</div>
      {% if section.button %}
      <div class="button-row"><a class="button button-primary" href="{{ section.button.url }}">{{ section.button.label }}</a></div>
      {% endif %}
    </div>
    {% if section.video %}
    <div class="feature-media">
      <video controls playsinline preload="metadata" {% if section.ambient %}autoplay muted loop{% endif %} {% if section.poster %}poster="{{ section.poster }}"{% endif %} src="{{ section.video }}"></video>
      {% if section.media_caption %}<p class="media-caption">{{ section.media_caption }}</p>{% endif %}
    </div>
    {% elif section.image %}
    <div class="feature-media">
      <img src="{{ section.image }}" alt="{{ section.image_alt or section.heading }}" {{ section.image | imgSize | safe }} loading="lazy" decoding="async">
      {% if section.media_caption %}<p class="media-caption">{{ section.media_caption }}</p>{% endif %}
    </div>
    {% endif %}
  </div>
</section>
