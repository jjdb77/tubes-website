<header class="site-header">
  <div class="container header-inner">
    <a class="site-logo" href="/" aria-label="{{ settings.site_name }} — home">
      <img src="{{ settings.logo }}" alt="{{ settings.site_name }} — {{ settings.tagline }}" width="158" height="55">
      <span class="logo-text logo-duo"><span class="logo-letters">{% for letter in settings.site_name | upper %}<b>{{ letter }}</b>{% endfor %}</span><small>{% for ch in settings.tagline %}<i>{% if ch == " " %} {% else %}{{ ch }}{% endif %}</i>{% endfor %}</small></span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      <ul>
        {% for item in settings.nav %}
        <li>
          <a href="{{ item.url }}" {% if page.url == item.url %}class="is-active" aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
    <a class="button button-primary header-cta" href="{{ settings.cta_url }}">{{ settings.cta_label }}</a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>
</header>
