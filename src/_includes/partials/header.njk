<header class="site-header">
  <div class="container header-inner">
    <a class="site-logo" href="/" aria-label="{{ settings.site_name }}, home">
      <img src="{{ settings.logo | imgSrc }}" alt="{{ settings.site_name }}, {{ settings.tagline | lower }}" width="158" height="55" fetchpriority="high">
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      <ul>
        {%- for item in settings.nav %}
        {%- if item.children %}
        {#- Groep met uitklapmenu. De groepsknop is een <button>, niet een link:
            de pagina zelf staat als eerste regel in het uitklapmenu. Zo werkt
            hij ook met het toetsenbord en op een aanraakscherm. -#}
        {%- set groupActive = false %}
        {%- for child in item.children %}{% if page.url == child.url %}{% set groupActive = true %}{% endif %}{% endfor %}
        <li class="has-submenu">
          <button type="button" class="nav-parent{% if groupActive %} is-active{% endif %}" aria-expanded="false">
            {{ item.label }}<span class="nav-caret" aria-hidden="true"></span>
          </button>
          <ul class="submenu">
            {%- for child in item.children %}
            <li><a href="{{ child.url }}"{% if page.url == child.url %} class="is-active" aria-current="page"{% endif %}>{{ child.label }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        {%- else %}
        <li>
          <a href="{{ item.url }}"{% if page.url == item.url %} class="is-active" aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {%- endif %}
        {%- endfor %}
        {%- if settings.app_login_url %}
        <li class="nav-app-item">
          <a class="nav-app" href="{{ settings.app_login_url }}">Application</a>
        </li>
        {%- endif %}
      </ul>
    </nav>
    {%- if page.url == "/" -%}
    <a class="button button-primary header-cta" href="{{ settings.header_cta_url or settings.cta_url }}" data-hc-open>{{ settings.header_cta_label or settings.cta_label }}</a>
    {%- else -%}
    <a class="button button-primary header-cta" href="{{ settings.cta_url }}">{{ settings.cta_label }}</a>
    {%- endif -%}
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>
</header>
