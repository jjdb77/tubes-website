{#- De drie iconen uit het zijmenu van de Tubes-app (app/views/shared/
    _nav_group_icon.html.erb): cirkel, zeshoek en driehoek als omlijning.
    Gebruikt in de hero (section.steps) en in de kop van een feature-sectie
    (section.step). De kleur komt uit --step, gezet door .step-<key> in
    style.css. -#}
{%- macro stepIcon(key, cls) -%}
<svg class="step-icon{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- if key == "budget" %}<circle cx="12" cy="12" r="10"></circle>
{%- elif key == "plan" %}<polygon points="12,1.75 20.9,6.9 20.9,17.1 12,22.25 3.1,17.1 3.1,6.9"></polygon>
{%- elif key == "produce" %}<polygon points="4,2.5 21.5,12 4,21.5"></polygon>
{%- endif %}</svg>
{%- endmacro -%}
