{#- Reclameblok voor Tubes zelf (veld `promo` op een sectie). Wie via Google
    in een zoek-en-vergelijklijst landt, scrolt zelden door tot het "Where
    Tubes fits"-blok onderaan; dit blok staat daarom bovenin en bij de
    kaarten. Varianten (promoVariant):
    - "hero": in de rechterkolom van de hero, naast de titel;
    - "aside": in de zijkolom van een directory-sectie, plakt mee tijdens
      het scrollen op brede schermen;
    - "inline": boven de kaarten, alleen op smalle schermen waar die zijkolom
      niet bestaat (uit te zetten met promo_inline: false op de sectie,
      bijvoorbeeld als de hero er al een heeft).
    De CSS toont van aside/inline altijd maar een van beide. -#}
{%- set promo = section.promo -%}
<aside class="guide-promo guide-promo-{{ promoVariant }}" aria-label="{{ promo.label or 'Tubes' }}">
  {% if promo.label %}<p class="guide-promo-label">{{ promo.label }}</p>{% endif %}
  <div class="guide-promo-body">
    <div class="guide-promo-text">
      <img class="guide-promo-logo" src="{{ '/assets/images/logo-tubes.png' | imgSrc }}" alt="Tubes" width="114" height="40" loading="lazy" decoding="async">
      <h3>{{ promo.heading }}</h3>
      {% if promo.text %}<p>{{ promo.text }}</p>{% endif %}
      {% if promo.chips %}
      <ul class="chip-row guide-promo-chips" aria-label="What Tubes covers">
        {% for chip in promo.chips %}<li class="chip chip-{{ chip.tone or 'teal' }}">{{ chip.label }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    <div class="guide-promo-actions">
      {% if promo.price %}<p class="guide-promo-price">{{ promo.price }}</p>{% endif %}
      {% if promo.button %}<a class="button button-primary" href="{{ promo.button.url }}">{{ promo.button.label }}</a>{% endif %}
      {% if promo.link %}<a class="guide-promo-link" href="{{ promo.link.url }}">{{ promo.link.label }}</a>{% endif %}
    </div>
  </div>
</aside>
