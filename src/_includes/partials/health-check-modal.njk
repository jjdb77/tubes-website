{#- De hele vragenlijst als popover. Hoort bij het blok uit
    health-check-hero.njk: de knop en het e-mailveld daar openen dit venster.
    Zelfde formulier-partial als de losse pagina, dus één bron. -#}
<dialog id="hc-modal" class="hc-modal" aria-labelledby="hc-modal-title">
  <div class="hc-modal-head">
    <h2 id="hc-modal-title">{{ healthcheck.title }}</h2>
    <button class="hc-modal-close" type="button" aria-label="Close">&times;</button>
  </div>
  <div class="hc-modal-body">
    {% include "partials/health-check-form.njk" %}
  </div>
</dialog>
