{%- set minutes = content | readingTime -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "partials/head-seo.njk" %}
  <link rel="icon" type="image/png" href="/assets/images/t-logo-small.png">
  <link rel="apple-touch-icon" href="/assets/images/t-logo-small.png">
  <meta name="theme-color" content="#0E9C88">
  <link rel="preload" href="/assets/fonts/mulish-5.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/fonts/mulish.css">
  <link rel="stylesheet" href="{{ assets.css }}">
  <script type="application/ld+json">
{{ { settings: settings, url: page.url, title: title, seoTitle: seo_title, description: description, article: { headline: title, date: page.date, words: content | wordCount } } | jsonld | safe }}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    <article class="section article">
      <div class="container article-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span>
          <a href="/insights/">Insights</a> <span aria-hidden="true">/</span>
          <span aria-current="page">{{ title }}</span>
        </nav>
        <h1>{{ title }}</h1>
        {% if standfirst %}<p class="article-standfirst">{{ standfirst }}</p>{% endif %}
        <p class="article-meta">
          <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
          <span aria-hidden="true">·</span> {{ minutes }} min read
        </p>
        <div class="rich-text article-body">
          {{ content | safe }}
        </div>
      </div>
    </article>

    <section class="section theme-teal">
      <div class="container article-inner">
        <h2 class="article-related-heading">Keep reading</h2>
        <ul class="article-related">
          {%- for item in collections.insights -%}
          {%- if item.url != page.url %}
          <li>
            <a href="{{ item.url }}">{{ item.data.title }}</a>
            <span>{{ item.data.standfirst or item.data.description }}</span>
          </li>
          {%- endif -%}
          {%- endfor %}
        </ul>
      </div>
    </section>

    {% set section = {
      title: "How does this work in your production?",
      text: "Book a free Production Health Check: 45 minutes on your production finance process, with practical findings you can use.",
      button: { label: "Book your free Production Health Check", url: "/production-finance-health-check/" }
    } %}
    {% include "partials/sections/cta.njk" %}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/demo-modal.njk" %}
  <script src="{{ assets.js }}" defer></script>
  {% if settings.goatcounter %}<script data-goatcounter="https://{{ settings.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>{% endif %}
</body>
</html>
