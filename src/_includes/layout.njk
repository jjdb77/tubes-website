<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "partials/head-seo.njk" %}
  <link rel="icon" type="image/png" href="/assets/images/t-logo-small.png">
  <link rel="apple-touch-icon" href="/assets/images/t-logo-small.png">
  <meta name="theme-color" content="#0E9C88">
  {#- Sneller laden = betere positie in Google. Het lettertype en de eerste
      afbeelding zijn wat de bezoeker als eerste ziet, dus die halen we alvast op. -#}
  <link rel="preload" href="/assets/fonts/mulish-5.woff2" as="font" type="font/woff2" crossorigin>
  {%- if sections and sections[0].type == "hero" and sections[0].image %}
  <link rel="preload" href="{{ sections[0].image }}" as="image" fetchpriority="high">
  {%- endif %}
  <link rel="stylesheet" href="/assets/fonts/mulish.css">
  <link rel="stylesheet" href="/css/style.css">
  <script type="application/ld+json">
{{ { settings: settings, url: page.url, title: title, seoTitle: seo_title, description: description, sections: sections, schemaSoftware: schema_software } | jsonld | safe }}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {% for section in sections %}
      {% include "partials/sections/" + section.type + ".njk" %}
    {% endfor %}
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/demo-modal.njk" %}
  <script src="/js/site.js" defer></script>
  {% if settings.goatcounter %}<script data-goatcounter="https://{{ settings.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>{% endif %}
</body>
</html>
