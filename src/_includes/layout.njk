<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "partials/head-seo.njk" %}
  <link rel="icon" type="image/png" href="/assets/images/t-logo-small.png">
  <link rel="apple-touch-icon" href="/assets/images/t-logo-small.png">
  <meta name="theme-color" content="#0E9C88">
  {#- Sneller laden = betere positie in Google. Het lettertype en de eerste
      afbeelding zijn wat de bezoeker als eerste ziet, dus die halen we alvast op. -#}
  <link rel="preload" href="/assets/fonts/mulish-5.woff2" as="font" type="font/woff2" crossorigin>
  {%- if sections and sections[0].type == "hero" and sections[0].image %}
  <link rel="preload" href="{{ sections[0].image }}" as="image" fetchpriority="high">
  {%- endif %}
  <link rel="stylesheet" href="/assets/fonts/mulish.css">
  <link rel="stylesheet" href="{{ assets.css }}">
  {#- Budget · Plan · Produce heeft eigen opmaak en script; alleen laden op
      pagina's met dat sectietype (nu: /solutions/). -#}
  {%- if sections | hasSection("processoverview") %}
  <link rel="stylesheet" href="{{ assets.budgetPlanProduceCss }}">
  {%- endif %}
  {#- Bedrijvengids: het bedrijf van deze pagina komt uit de index op URL. Zo
      krijgt de jsonld-filter een echt object; via de front matter zou het een
      string zijn en bleef de Organization leeg. -#}
  {%- set bedrijf = companyIndex.byUrl[page.url] -%}
  {%- set product = softwareIndex.byUrl[page.url] -%}
  {%- set pad = crumbs -%}
  {%- if bedrijf -%}{%- set pad = [{ name: "Companies", url: "/companies/" }, { name: bedrijf.country, url: bedrijf.countryUrl }] -%}{%- endif -%}
  {%- if product -%}{%- set pad = [{ name: "Software", url: "/software/" }, { name: product.category, url: product.categoryUrl }] -%}{%- endif -%}
  <script type="application/ld+json">
{{ { settings: settings, url: page.url, title: title, seoTitle: seo_title, description: description, sections: sections, schemaSoftware: schema_software, company: bedrijf, product: product, crumbs: pad, itemList: itemList } | jsonld | safe }}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {% for section in sections %}
      {% include "partials/sections/" + section.type + ".njk" %}
    {% endfor %}
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {#- Gratis tools (browser_only in de front matter) draaien onder een
      Content-Security-Policy zonder uitgaande verbindingen. Daar geen
      demo-popup (die post naar /api/contact; de knoppen gaan dan gewoon naar
      /contact/) en geen statistiek-script. -#}
  {% if browser_only %}{% include "partials/demo-modal-frame.njk" %}{% else %}{% include "partials/demo-modal.njk" %}{% endif %}
  <script src="{{ assets.js }}" defer></script>
  {%- if sections | hasSection("processoverview") %}
  <script src="{{ assets.budgetPlanProduceJs }}" defer></script>
  {%- endif %}
  {% if not browser_only %}{% include "partials/analytics.njk" %}{% endif %}
</body>
</html>
