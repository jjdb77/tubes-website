<style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:grid;place-items:center;min-height:100vh;margin:0;color:#1c2b33}</style>
</head>
<body>
<p>One moment&hellip; <a href="{{ settings.booking_url }}">continue to the booking page</a>.</p>
<script>location.replace({{ settings.booking_url | dump | safe }});</script>
</body>
</html>
