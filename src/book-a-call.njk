---
pagination:
  data: settings.booking_plans
  size: 1
  alias: boeking
permalink: "/book-a-call/{{ boeking.path }}"
eleventyExcludeFromCollections: true
---
{#- Doorstuurpagina's naar de agenda. Elke "Book a call"-knop wijst naar een
    pad hieronder, zodat de echte boekingslink op één plek staat (settings:
    booking_url + booking_plans). Per plan een eigen pagina, zodat de juiste
    agenda ook zonder JavaScript wordt geopend; de plannaam gaat als ?plan=
    mee en verschijnt bij de boeking. -#}
{#- Zonder slug sturen we door naar de agenda zelf, waar alle afspraaktypes
    op staan. Handig voor een nieuw type dat nog gemaakt moet worden. -#}
{%- set doel = (boeking.booking_url or settings.booking_url) -%}
{%- if boeking.slug -%}{%- set doel = doel + "/" + boeking.slug -%}{%- endif -%}
{%- if boeking.plan -%}{%- set doel = doel + "?plan=" + (boeking.plan | urlencode) -%}{%- endif -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Book a call — {{ settings.site_name }}</title>
<meta name="robots" content="noindex">
<meta http-equiv="refresh" content="0; url={{ doel }}">
<link rel="canonical" href="{{ doel }}">
<style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:grid;place-items:center;min-height:100vh;margin:0;color:#1c2b33}</style>
</head>
<body>
<p>One moment&hellip; <a href="{{ doel }}">continue to the booking page</a>.</p>
<script>
// Komt er een eigen ?plan= mee (de Health Check stuurt daar de antwoorden in),
// dan heeft die voorrang op de standaardwaarde hierboven.
(function () {
  var doel = {{ doel | dump | safe }};
  var mee = new URLSearchParams(location.search).get('plan');
  if (mee) doel = doel.split('?')[0] + '?plan=' + encodeURIComponent(mee);
  location.replace(doel);
})();
</script>
</body>
</html>
