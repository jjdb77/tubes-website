---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- De sitemap wijst Google naar alle vindbare pagina's. Pagina's met
    `noindex: true` in de front matter blijven er buiten, net als de
    doorstuurpagina's (die staan al buiten de collecties). -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{%- if not item.data.noindex %}
  <url>
    <loc>{{ settings.site_url }}{{ item.url }}</loc>
    <lastmod>{{ item.date.toISOString().split('T')[0] }}</lastmod>
    <changefreq>{% if item.url == "/" %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if item.url == "/" %}1.0{% elif item.url in ["/platform/", "/plans/", "/solutions/"] %}0.9{% else %}0.7{% endif %}</priority>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
