---
permalink: /insights/
title: Insights
seo_title: "Production Budgeting Insights | Tubes"
description: "Practical guides on production budgeting, cost reporting and cost control, written for producers, production managers and production accountants."
noindex: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "partials/head-seo.njk" %}
  <link rel="icon" type="image/png" href="/assets/images/t-logo-small.png">
  <link rel="apple-touch-icon" href="/assets/images/t-logo-small.png">
  <meta name="theme-color" content="#0E9C88">
  <link rel="preload" href="/assets/fonts/mulish-5.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/fonts/mulish.css">
  <link rel="stylesheet" href="{{ assets.css }}">
  <script type="application/ld+json">
{{ { settings: settings, url: page.url, title: title, seoTitle: seo_title, description: description, itemList: collections.insights } | jsonld | safe }}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    <section class="section section-hero">
      <div class="container hero-grid hero-single">
        <div class="hero-text">
          <span class="kicker">Insights</span>
          <h1>Production budgeting, <em>explained</em></h1>
          <div class="rich-text lead">
            <p>Practical guides to how production budgets are built, tracked and reported. Written for producers, production managers, line producers and production accountants who work with these numbers every day.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section theme-white">
      <div class="container">
        <ul class="insights-list">
          {%- for item in collections.insights %}
          <li class="insight-card">
            <p class="insight-meta">
              <time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time>
              <span aria-hidden="true">·</span> {{ item.templateContent | readingTime }} min read
            </p>
            <h2><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
            <p>{{ item.data.standfirst or item.data.description }}</p>
            <a class="insight-link" href="{{ item.url }}">Read the guide</a>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    {% set section = {
      title: "See it working on a real budget",
      text: "Tubes connects the budget to what is actually being spent, so the cost report is a by-product of the work instead of a weekly reconstruction.",
      button: { label: "Request a Demo", url: "/contact/" }
    } %}
    {% include "partials/sections/cta.njk" %}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/demo-modal.njk" %}
  <script src="{{ assets.js }}" defer></script>
  {% if settings.goatcounter %}<script data-goatcounter="https://{{ settings.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>{% endif %}
</body>
</html>
