---
permalink: /news/
title: News
seo_title: "Film and TV production news | Tubes"
description: "What is new at Tubes, plus the film and television posts we are reading on LinkedIn: budgets, financing, AI in production, festivals and markets."
---
{#- Nieuwsoverzicht. Twee stromen uit dezelfde map src/content/news:
    kind "tubes" (eigen aankondigingen) en kind "industry" (gevonden
    LinkedIn-posts). Zie de toelichting bij de collecties in
    eleventy.config.js. -#}
{%- set topicChip = {
  "Budgeting": "chip",
  "AI in production": "chip chip-lavender",
  "Festivals": "chip chip-blue",
  "Product": "chip chip-amber"
} -%}
{%- macro linkedinIcon() -%}
<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "partials/head-seo.njk" %}
  <link rel="icon" type="image/png" href="/assets/images/t-logo-small.png">
  <link rel="apple-touch-icon" href="/assets/images/t-logo-small.png">
  <meta name="theme-color" content="#0E9C88">
  <link rel="preload" href="/assets/fonts/mulish-5.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/fonts/mulish.css">
  <link rel="stylesheet" href="{{ assets.css }}">
  <script type="application/ld+json">
{{ { settings: settings, url: page.url, title: title, seoTitle: seo_title, description: description } | jsonld | safe }}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    <section class="section section-hero">
      <div class="container hero-grid hero-single">
        <div class="hero-text">
          <span class="kicker">News</span>
          <h1>What we are <em>reading</em> this month</h1>
          <div class="rich-text lead">
            <p>Two things in one place: what is new at Tubes, and the film and television posts worth your time from our LinkedIn feed. Budgets and financing, AI in production, festivals and markets. We link back to the original post wherever we can.</p>
          </div>
          <div class="button-row">
            <a class="button button-primary" href="{{ settings.socials.linkedin }}" target="_blank" rel="noopener">Follow Tubes on LinkedIn</a>
            <a class="button button-secondary" href="/insights/">Read the guides</a>
          </div>
        </div>
      </div>
    </section>

    {%- if collections.newsTubes.length %}
    <section class="section theme-white">
      <div class="container">
        <h2 class="section-heading">What&rsquo;s new at Tubes</h2>
        <p class="section-intro">Product news, releases and where you can find us.</p>
        <ul class="news-list news-list-tubes">
          {%- for item in collections.newsTubes %}
          <li class="news-card news-card-tubes">
            <p class="news-meta">
              <span class="{{ topicChip[item.data.topic] or 'chip chip-amber' }}">{{ item.data.topic or "Tubes" }}</span>
              <time datetime="{{ item.date | isoDate }}">{{ item.date | monthYear }}</time>
            </p>
            <h3>{{ item.data.title }}</h3>
            <div class="news-summary">{{ item.templateContent | safe }}</div>
            {%- if item.data.link %}
            <a class="news-link" href="{{ item.data.link }}" target="_blank" rel="noopener">Read the post {{ linkedinIcon() }}</a>
            {%- endif %}
          </li>
          {%- endfor %}
        </ul>
      </div>
    </section>
    {%- endif %}

    {%- if collections.newsIndustry.length %}
    <section class="section">
      <div class="container">
        <h2 class="section-heading">From the industry</h2>
        <p class="section-intro">Posts we came across on LinkedIn, summarised in a line or two. The opinions are the writers&rsquo;, not ours.</p>
        {%- for item in collections.newsIndustry %}
        {%- set month = item.date | monthYear %}
        {%- if loop.first or (collections.newsIndustry[loop.index0 - 1].date | monthYear) != month %}
        {%- if not loop.first %}</ul>{% endif %}
        <h3 class="news-month">{{ month }}</h3>
        <ul class="news-list">
        {%- endif %}
          <li class="news-card{% if not item.data.link %} news-card-nolink{% endif %}">
            <p class="news-meta">
              <span class="{{ topicChip[item.data.topic] or 'chip chip-mint' }}">{{ item.data.topic }}</span>
              <span class="news-source">{{ item.data.source }}</span>
            </p>
            <h4>{{ item.data.title }}</h4>
            <div class="news-summary">{{ item.templateContent | safe }}</div>
            {%- if item.data.link %}
            <a class="news-link" href="{{ item.data.link }}" target="_blank" rel="noopener">
              <span>View on LinkedIn</span> {{ linkedinIcon() }}
              <span class="visually-hidden">: {{ item.data.title }}</span>
            </a>
            {%- else %}
            <p class="news-link news-link-none">Shared on LinkedIn by {{ item.data.source }}</p>
            {%- endif %}
          </li>
        {%- if loop.last %}</ul>{% endif %}
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {% set section = {
      title: "Budgeting, planning and cost control in one place",
      text: "Tubes connects the budget to what is actually being spent, so the cost report is a by-product of the work instead of a weekly reconstruction.",
      button: { label: "Request a Demo", url: "/contact/" }
    } %}
    {% include "partials/sections/cta.njk" %}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/demo-modal.njk" %}
  <script src="{{ assets.js }}" defer></script>
  {% if settings.goatcounter %}<script data-goatcounter="https://{{ settings.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>{% endif %}
</body>
</html>
