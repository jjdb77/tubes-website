{% raw %}
<script>
(function () {
  var stage = document.getElementById("tp-stage");
  var slides = Array.prototype.slice.call(stage.querySelectorAll(".tp-slide"));
  var prev = document.getElementById("tp-prev");
  var next = document.getElementById("tp-next");
  var count = document.getElementById("tp-count");
  var full = document.getElementById("tp-full");
  var stackQuery = window.matchMedia("(max-width: 760px) and (orientation: portrait)");
  var cur = 0;

  function fromHash() {
    var n = parseInt(String(location.hash).replace("#", ""), 10);
    return n >= 1 && n <= slides.length ? n - 1 : 0;
  }
  function fit() {
    var stack = stackQuery.matches;
    document.body.classList.toggle("tp-stack", stack);
    var w = stack ? document.documentElement.clientWidth - 24 : stage.clientWidth;
    var h = stack ? Infinity : stage.clientHeight;
    var s = Math.min(w / 1920, h / 1080);
    document.documentElement.style.setProperty("--s", String(s));
  }
  function show(i, keepHash) {
    cur = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach(function (el, k) { el.hidden = k !== cur; });
    count.textContent = (cur + 1) + " / " + slides.length;
    prev.disabled = cur === 0;
    next.disabled = cur === slides.length - 1;
    if (!keepHash) history.replaceState(null, "", "#" + (cur + 1));
  }
  prev.addEventListener("click", function () { show(cur - 1); });
  next.addEventListener("click", function () { show(cur + 1); });
  document.addEventListener("keydown", function (e) {
    if (e.altKey || e.ctrlKey || e.metaKey || document.body.classList.contains("tp-stack")) return;
    var k = e.key;
    if (k === "ArrowRight" || k === "ArrowDown" || k === "PageDown" || k === " ") { e.preventDefault(); show(cur + 1); }
    else if (k === "ArrowLeft" || k === "ArrowUp" || k === "PageUp") { e.preventDefault(); show(cur - 1); }
    else if (k === "Home") { e.preventDefault(); show(0); }
    else if (k === "End") { e.preventDefault(); show(slides.length - 1); }
    else if (k === "f" || k === "F") { toggleFull(); }
  });
  var touchX = null;
  stage.addEventListener("touchstart", function (e) { touchX = e.touches[0].clientX; }, { passive: true });
  stage.addEventListener("touchend", function (e) {
    if (touchX === null || document.body.classList.contains("tp-stack")) return;
    var dx = e.changedTouches[0].clientX - touchX;
    touchX = null;
    if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
  });
  function toggleFull() {
    var el = document.documentElement;
    if (document.fullscreenElement) document.exitFullscreen();
    else if (el.requestFullscreen) el.requestFullscreen();
  }
  if (document.documentElement.requestFullscreen) full.addEventListener("click", toggleFull);
  else full.hidden = true;
  document.addEventListener("fullscreenchange", function () {
    full.textContent = document.fullscreenElement ? "Exit full screen" : "Full screen";
    fit();
  });
  window.addEventListener("resize", fit);
  window.addEventListener("hashchange", function () { show(fromHash(), true); });
  if (stackQuery.addEventListener) stackQuery.addEventListener("change", fit);
  fit();
  show(fromHash(), true);
})();
</script>
