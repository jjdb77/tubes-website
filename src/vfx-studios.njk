    .tp-stage {
      position: fixed; inset: 0 0 56px 0;
      display: flex; align-items: center; justify-content: center;
    }
    .tp-slide {
      position: relative; flex: none; overflow: hidden;
      width: calc(1920px * var(--s, 0.5)); height: calc(1080px * var(--s, 0.5));
      background: #F6F7F9;
      box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.6);
    }
    .tp-slide[hidden] { display: none; }

    /* Een dia is een vast canvas van 1920x1080 dat als geheel wordt geschaald. */
    .tp-slide > section {
      position: absolute; left: 0; top: 0; width: 1920px; height: 1080px;
      box-sizing: border-box; overflow: hidden;
      transform-origin: 0 0; transform: scale(var(--s, 0.5));
    }
    .tp-slide > section * { box-sizing: border-box; margin: 0; }
    .tp-slide h1 { font-weight: 600; line-height: 1.1; }
    .tp-slide h2 { font-weight: 600; line-height: 1.15; }
